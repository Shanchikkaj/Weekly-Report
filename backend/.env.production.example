# ==============================================================================
# PRODUCTION ENVIRONMENT VARIABLE CHECKLIST (RENDER FREE WEB SERVICE)
# Do NOT commit your actual values to Git. Set these in Render Dashboard -> Environment.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=10000

# 1. Neon Free PostgreSQL
# Pooled connection string (with -pooler in hostname and ?sslmode=require) for runtime queries:
DATABASE_URL=postgresql://<user>:<password>@<neon-subdomain>-pooler.neon.tech/<dbname>?sslmode=require
# Direct connection string (without -pooler, standard port 5432 with ?sslmode=require) for Prisma migrations:
DIRECT_URL=postgresql://<user>:<password>@<neon-subdomain>.neon.tech/<dbname>?sslmode=require

# 2. MongoDB Atlas M0 Sandbox
# From MongoDB Atlas -> Deployment -> Database -> Connect -> Drivers -> Node.js
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-subdomain>.mongodb.net/weekly_report?retryWrites=true&w=majority

# 3. Upstash Free Serverless Redis
# From Upstash Console -> Databases -> Details -> Node.js (ioredis) or REST URL (starts with rediss:// for TLS)
REDIS_URL=rediss://default:<upstash-password>@<upstash-endpoint>.upstash.io:6379

# 4. Frontend Client URL (Vercel)
# After deploying frontend on Vercel Hobby, enter its assigned production domain here:
CLIENT_URL=https://<your-project-name>.vercel.app

# 5. Cryptographically Secure JWT Secrets (Render can auto-generate or use openssl rand -hex 32)
JWT_SECRET=generate_or_paste_32_char_minimum_random_secret
JWT_REFRESH_SECRET=generate_or_paste_32_char_minimum_random_secret

# 6. Google AI Studio Gemini API Key
# From Google AI Studio (https://aistudio.google.com/) -> Get API Key
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-3.5-flash-lite

# 7. Application Timezone & Cookie Settings
APP_TIMEZONE=Asia/Colombo
COOKIE_SAMESITE=lax
