# ==============================================================================
# FRONTEND PRODUCTION ENVIRONMENT VARIABLES (VERCEL HOBBY)
# Set in Vercel Dashboard -> Settings -> Environment Variables
# ==============================================================================

# Same-Origin API Proxy Architecture:
# Leave VITE_API_URL blank (or empty) so requests use relative `/api/*`.
# Vercel rewrites automatically proxy `/api/*` to the Render backend service,
# ensuring the httpOnly refresh-token cookie is handled under same-origin semantics.
VITE_API_URL=
